{
  "name": "forecastforplanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forecast for Planner — 供应链计划员统计与机器学习预测互动教程 (纯前端静态应用 + 配套讲义)",
  "scripts": {
    "serve": "node scripts/serve.mjs 8110",
    "test": "node --test tests/*.test.mjs",
    "check": "READY_EXPR=\"document.documentElement.dataset.ffpReady === 'true' && document.querySelectorAll('.rail-item').length === 8\" node scripts/browser-check.mjs http://localhost:8110/ scripts/driver-all.mjs",
    "check:mobile": "WINDOW_SIZE=420,800 READY_EXPR=\"document.documentElement.dataset.ffpReady === 'true'\" node scripts/browser-check.mjs http://localhost:8110/ scripts/driver-mobile.mjs",
    "check:lec": "node scripts/check-lectures.mjs",
    "check:live": "READY_TIMEOUT_MS=180000 READY_EXPR=\"document.documentElement.dataset.ffpReady === 'true' && document.querySelectorAll('.rail-item').length === 8\" node scripts/browser-check.mjs https://lianmao.github.io/forecastforplanner/ scripts/driver-all.mjs",
    "check:live:lec": "BASE=https://lianmao.github.io/forecastforplanner/lectures/ node scripts/check-lectures.mjs",
    "shots": "node scripts/screenshot.mjs http://localhost:8110/ /tmp/ffp-shots scripts/steps-shots.mjs",
    "facts": "node scripts/lecture-facts.mjs > lectures/FACTS.txt && echo 'lectures/FACTS.txt 已更新'",
    "audit:numbers": "node scripts/audit-lecture-numbers.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "calibrate": "node scripts/calibrate-promo.mjs && node scripts/measure-recovery.mjs"
  },
  "devDependencies": {
    "echarts": "^5.5.1",
    "esbuild": "^0.25.0"
  }
}
